{
  "name": "@amoeba/upgrade-governance-vectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "generate:vectors": "node --import tsx tools/generate-vectors.ts",
    "check:vectors": "node --import tsx tools/generate-vectors.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:vectors && node --import tsx --test upgradeGovernance/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
