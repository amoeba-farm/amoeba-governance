{
  "name": "@amoeba/upgrade-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/upgradeGovernance/index.js",
  "types": "./dist/upgradeGovernance/index.d.ts",
  "bin": {
    "amoeba-upgrade-governance": "./dist/upgradeGovernance/cliMain.js"
  },
  "exports": {
    ".": {
      "types": "./dist/upgradeGovernance/index.d.ts",
      "import": "./dist/upgradeGovernance/index.js"
    },
    "./upgrade-governance": {
      "types": "./dist/upgradeGovernance/index.d.ts",
      "import": "./dist/upgradeGovernance/index.js"
    }
  },
  "files": [
    "dist/upgradeGovernance"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "generate:bridge": "node --import tsx tools/generate-spread-gate-bridge.ts",
    "generate:release1-vectors": "node --import tsx tools/generate-release1-vectors.ts",
    "generate:vectors": "node --import tsx tools/generate-vectors.ts",
    "check:bridge": "node --import tsx tools/generate-spread-gate-bridge.ts --check",
    "check:release1-vectors": "node --import tsx tools/generate-release1-vectors.ts --check",
    "check:vectors": "node --import tsx tools/generate-vectors.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:package": "npm run build && node --import tsx tools/check-package-consumer.ts && npm pack --dry-run --json",
    "test": "npm run check:vectors && npm run check:bridge && npm run check:release1-vectors && node --import tsx --test upgradeGovernance/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
